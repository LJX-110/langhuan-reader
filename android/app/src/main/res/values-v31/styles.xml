<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 系统启动页：纸白底 + 手绘月牙屋檐动画。低版本仍用 launch_background。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_mark_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">650</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
