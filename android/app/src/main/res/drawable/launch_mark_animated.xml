<?xml version="1.0" encoding="utf-8"?>
<!-- 启动动画：月牙淡入（260ms），屋檐从两端向中间画出（180ms 后开始，420ms）。 -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/launch_mark_vector">

    <target android:name="moon">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>

    <target android:name="cut">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>

    <target android:name="eave">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="420"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startDelay="180"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
